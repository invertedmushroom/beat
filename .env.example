VITE_DIRECTORY_DRIVER=local

# Use this for a local SpacetimeDB server started with `spacetime start`.
# VITE_DIRECTORY_DRIVER=spacetime
# VITE_STDB_URI=http://127.0.0.1:3000
# VITE_STDB_DATABASE=beat-rooms-local

# Use this after `npm run stdb:publish:maincloud`.
# VITE_DIRECTORY_DRIVER=spacetime
# VITE_STDB_URI=https://maincloud.spacetimedb.com
# VITE_STDB_DATABASE=beat-rooms

# WebRTC ICE servers. Default is STUN-only, which works on many LAN / home
# networks but can fail on cellular, guest Wi-Fi, or other symmetric-NAT
# networks. For reliable phone hosting, configure a real TURN relay.
#
# Option 1: fetch a full iceServers JSON array from a provider endpoint.
# Recommended for GitHub Pages: deploy the worker in `turn-worker/` and point
# this at its URL. The worker mints short-lived Cloudflare TURN credentials
# without exposing your API token to the browser.
# VITE_ICE_SERVERS_URL=https://beat-turn.<your-subdomain>.workers.dev
#
# Metered also follows this pattern:
# VITE_ICE_SERVERS_URL=https://yourapp.metered.live/api/v1/turn/credentials?apiKey=API_KEY
#
# Option 2: provide explicit STUN/TURN values directly (creds ship in bundle).
# VITE_STUN_URLS=stun:stun.l.google.com:19302
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
