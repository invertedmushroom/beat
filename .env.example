VITE_DIRECTORY_DRIVER=local

# Use this for a local SpacetimeDB server started with `spacetime start`.
# VITE_DIRECTORY_DRIVER=spacetime
# VITE_STDB_URI=http://127.0.0.1:3000
# VITE_STDB_DATABASE=beat-rooms-local

# Use this after `npm run stdb:publish:maincloud`.
# VITE_DIRECTORY_DRIVER=spacetime
# VITE_STDB_URI=https://maincloud.spacetimedb.com
# VITE_STDB_DATABASE=beat-rooms

# WebRTC ICE servers. Defaults to Google STUN + Open Relay's free public TURN
# so hosting from a phone on cellular / symmetric-NAT networks works out of
# the box. Set VITE_TURN_URL (and optionally VITE_TURN_USERNAME /
# VITE_TURN_CREDENTIAL) to use your own TURN. Set VITE_DISABLE_DEFAULT_TURN=1
# to drop the public TURN fallback (STUN-only, LAN-style hosting).
# VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
