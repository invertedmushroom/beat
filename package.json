{
  "name": "beat",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:https": "vite --host 0.0.0.0 --mode device-https",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:structural": "ast-grep scan --config sgconfig.yml",
    "preview": "vite preview --host 127.0.0.1",
    "preview:https": "npm run build && vite preview --host 0.0.0.0 --mode device-https",
    "pwa:icons": "node tools/pwa-icons.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:structural": "ast-grep test --config sgconfig.yml",
    "stdb:build": "spacetime build -p spacetimedb",
    "stdb:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb --no-config",
    "stdb:publish:local": "spacetime publish beat-rooms-local -p spacetimedb -s local --no-config",
    "stdb:publish:maincloud": "spacetime publish beat-rooms -p spacetimedb -s maincloud --no-config",
    "stdb:dev": "spacetime dev beat-rooms-local --server local --server-only --project-path . --module-path spacetimedb --module-bindings-path src/module_bindings --client-lang typescript -y --no-config"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3",
    "spacetimedb": "2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.14",
    "wrangler": "^4.94.0"
  }
}
